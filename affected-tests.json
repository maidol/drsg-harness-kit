{
  "always": [
    "python3 tools/check-docs.py",
    "python3 tools/check-no-machine-paths.py tools tests skills claude"
  ],
  "full": "bash tests/test-all.sh",
  "shell": {
    "tests": "tests/*.sh",
    "exclude": [
      "tests/test-all.sh"
    ],
    "path_map": {
      "tools/workflow_permissions.py": [
        "tests/workflow-permissions.sh",
        "tests/audit-deployment.sh",
        "tests/setup-all-projects.sh",
        "tests/setup-reuse-token.sh"
      ],
      "tests/workflow-permissions.py": ["tests/workflow-permissions.sh"],
      "tools/templates/settings-hooks.json": [
        "tests/setup-reuse-token.sh",
        "tests/superpowers-doc-guard.sh"
      ]
    }
  }
}
