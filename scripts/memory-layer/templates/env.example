# dr-strange memory layer — per-project .drsg/env
# install.sh generates this from these values. All hooks read it.

# --- Core (required) ---
# Shared API token for the daemon (native clients need Bearer auth).
DRSG_TOKEN=change-me
# The daemon's JSON-RPC endpoint.
DRSG_API=http://127.0.0.1:7700/rpc
# The plane that holds memory (one per deployment; projects are separated by
# the Project node key, not by plane).
DRSG_PLANE=memory

# --- L3 LLM distillation (optional — leave DRSG_L3_CHAT empty to disable) ---
# Chat provider: a digest.run preset name (openai / deepseek / qwen / ollama),
# or a raw OpenAI-compatible base URL where the daemon's digest.run takes one.
DRSG_L3_CHAT=
# Env var name the daemon reads the LLM key from (server-side; never in
# params). Empty → the preset's own (OPENAI_API_KEY for `openai`, and so on).
DRSG_L3_KEY_ENV=
# Model id, exactly as the endpoint lists it. Empty → the provider's default.
DRSG_L3_MODEL=
# "none" turns reasoning off where the provider understands it, so a reasoning
# model doesn't spend the output budget thinking and truncate the JSON
# digest.run has to parse. Empty → provider default.
DRSG_L3_REASONING=
